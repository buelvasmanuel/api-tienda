# Copia este archivo como .env y pon tu contraseña:
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# .env NO se sube a Git (está en .gitignore).

DB_USER=tienda_user
DB_PASSWORD=tienda_pass_123
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tienda_db

# Clave de los tokens de sesión (obligatoria). Genera una con:
#   python -m scripts.generar_clave
# y pega la salida aquí, en lugar de este texto:
CLAVE_TOKENS=pega_aqui_la_salida_de_generar_clave

# Orígenes permitidos por CORS (obligatoria). En local, "*" (cualquiera);
# en producción, solo el dominio de la app web: https://buelvasmanuel.github.io
CORS_ORIGINS=*

# Opcionales (en local se dejan comentadas):
# DB_SSL_CA=ca.pem      # ruta o contenido del certificado de la CA (Aiven)
# IP_CLIENTE=conexion   # de dónde sale la IP para el límite por IP (ver app/config.py)
